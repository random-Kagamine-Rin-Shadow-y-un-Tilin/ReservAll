# Copia este archivo como .env y completa los valores reales.
DATABASE_URL=postgresql://usuario:password@host:5432/postgres
JWT_SECRET=cambia-esto
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=14
API_KEY=cambia-esto

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_BUCKET=negocios_fotos

CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Notificaciones push (Web Push / VAPID)
# Genera un par de claves con:
#   python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.public_key_urlsafe); print(v.private_key_urlsafe)"
PUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@reservall.local
PUSH_LEAD_MINUTES=0
PUSH_CHECK_INTERVAL_SECONDS=30
